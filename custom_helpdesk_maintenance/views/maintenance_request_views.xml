<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_request_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.merged</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">


            <xpath expr="//header" position="inside">
                <button name="action_create_helpdesk_ticket" 
                        type="object" 
                        string="Crear Ticket de Soporte" 
                        class="oe_highlight"/>
            </xpath>

            <xpath expr="//sheet/*[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_helpdesk_tickets" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-life-ring">
                        <field name="ticket_count" widget="statinfo" string="Tickets"/>
                    </button>
                </div>

                <div class="alert alert-danger text-center mb-2" 
                     role="alert" 
                     invisible="not robot_out_of_service" 
                     style="font-weight: bold; border-radius: 0; margin-top: 5px; border: none;">
                    <i class="fa fa-exclamation-triangle" style="margin-right: 8px;"/> 
                    ¡ATENCIÓN! EL ROBOT SE ENCUENTRA FUERA DE SERVICIO
                </div>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="after">
                <field name="ticket_count" invisible="1"/>
                <field name="robot_out_of_service" invisible="1"/>
                <field name="ticket_ids" widget="many2many_tags" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='equipment_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="partner_id" string="Cliente"/>
                <field name="tour_id" options="{'no_create': True}" readonly="1" force_save="1"/>
            </xpath>

            <xpath expr="//field[@name='maintenance_team_id']" position="after">
                <field name="equipment_manager_id"/>
                <field name="assigned_employee_id"/>
            </xpath>

        </field>
    </record>
</odoo>