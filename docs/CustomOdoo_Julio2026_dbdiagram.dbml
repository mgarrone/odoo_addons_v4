// ==========================================
// DBML SCHEMA FOR CUSTOM ODOO MODULES
// Fuente de verdad de personalizaciones Automatiza
// Excluye: custom_helpdesk_maintenanceV0
//
// Módulos:
//   custom_crm_v4 | custom_project | custom_giras
//   custom_maintenance | custom_helpdesk_maintenance | custom_stock_picking
//
// Copy and paste this code in dbdiagram.io
// ==========================================

// -------------------------------------------------------------
// MODULE: custom_crm_v4
// -------------------------------------------------------------
Table crm_lead {
  id int [pk, increment]
  partner_id int [ref: > res_partner.id, note: 'Cliente (nativo)']
  currency_id int [ref: > res_currency.id, note: 'Related company currency']

  // Información adicional / Seguimiento
  x_proyecto_id int [ref: > project_project.id, note: 'COMPUTED readonly — vía project.opportunity_id']
  x_complejidad varchar [note: 'Selection: bajo | normal | alto']
  x_canal_de_ingreso varchar
  x_id_cliente int [note: 'Related partner_id.id']
  x_responsable_comercial_id int [ref: > res_users.id]
  x_responsable_proyecto_id int [ref: > res_users.id]
  x_cantidad_robots int
  // project_ids O2M (custom_project) → project_project.opportunity_id
  // x_detalle_de_equipos O2M → x_lista_de_robots.opportunity_id
  // x_cotizaciones O2M → sale_order.opportunity_id
  // x_contacto_ids M2M → crm_lead_x_contacto_rel

  // Cronología
  x_studio_ingreso_consulta date
  x_studio_date_field_3vh_1jau2o5rh date [note: 'Primer Llamada']
  x_studio_videollamada date
  x_studio_reunin_presencial date
  x_studio_envo_presentacin date
  x_studio_envo_ffq date
  x_studio_cotizacin date
  x_studio_firma_cotizacin date
  x_studio_acta_ec date
  x_studio_vencimiento date
  x_studio_visita_de_cortesa date
  x_fecha_torta_aniversario date
  x_fecha_foto_aniversario date

  // Datos de Cotización
  x_studio_cotizacin_bd varchar
  x_studio_char_field_4bc_1jbo2kegr varchar [note: 'Url Cotización']
  x_studio_modelo_comercial_1 varchar [note: 'bd_argentina | atza_uy | otro']
  x_studio_tipo_de_cotizacin varchar [note: 'robot | refit | otro']
  x_studio_hardware float [note: 'Monetary']
  x_studio_servicio float [note: 'Monetary']
  x_studio_descuento_aplicado_ float
  x_studio_total_neto float [note: 'Monetary']
  x_studio_nmero_de_venta int
  x_studio_nmero_de_cliente int
  x_studio_nmero_de_instalacin int

  // Producto cotizado (legacy Studio)
  x_studio_producto varchar [note: 'smart | vmax | otro']
  x_studio_alto float
  x_studio_ancho float
  x_studio_largo float
  x_studio_salidas int
  x_studio_capacidad_mnima_1 int
  x_studio_capacidad_mxima int
  x_studio_cinta_de_transporte_1 float
  x_studio_easy_load_1 int
  x_studio_espirales_1 int
  x_studio_vidrios_laterales_1 int
  x_studio_vidrios_fondo int
  x_studio_vidrios_piso int
  x_studio_ubicacin varchar
  x_studio_software_gestion_text varchar
  x_studio_otro_complemento varchar [note: 'Html']

  Note: '''
  custom_crm_v4
  - Layout Información adicional: Compañía|Contactos / Marketing|Seguimiento
  - x_proyecto_id calculado desde project.project.opportunity_id
  '''
}

Table crm_lead_x_contacto_rel {
  lead_id int [ref: > crm_lead.id]
  partner_id int [ref: > res_partner.id]
  Note: 'x_contacto_ids M2M — Contactos de la empresa'
}

// -------------------------------------------------------------
// MODULE: custom_project
// -------------------------------------------------------------
Table project_project {
  id int [pk, increment]
  name varchar
  opportunity_id int [unique, ref: > crm_lead.id, note: 'UNIQUE opportunity_id_uniq']
  bd_robot_code varchar
  bd_pid int
  task_count int [note: 'Computed']
  // robot_scenario_ids O2M → x_lista_de_robots.project_id
  // type_ids M2M → project_project_task_type_rel

  Note: '''
  custom_project
  - Sync opportunity_id → escenarios + refresca x_proyecto_id
  - Etapas default en todos los proyectos
  '''
}

Table project_task_type {
  id int [pk, increment]
  name varchar
  sequence int
  Note: 'XML: A realizar | En proceso | Finalizadas | Canceladas'
}

Table project_project_task_type_rel {
  project_id int [ref: > project_project.id]
  type_id int [ref: > project_task_type.id]
  Note: 'type_ids del proyecto'
}

Table x_lista_de_robots {
  id int [pk, increment]
  name varchar [not null]
  project_id int [ref: > project_project.id]
  opportunity_id int [ref: > crm_lead.id, note: 'readonly — sync auto desde project']
  product_id int [ref: > product_product.id, note: 'dominio categ Robots XML ID']
  is_vmax boolean [note: 'Computed stored']
  scenario int
  ffq_url varchar
  height float
  length float
  width float
  min_capacity int
  max_capacity int
  conveyor_belt float
  deflectors int
  easy_load boolean
  easy_load_buffer float
  spirals int
  second_picking_arm boolean
  second_input_belt boolean
  refrigeration_module boolean
  cleaning_module boolean
  side_glasses int
  back_glass boolean
  floor_glass boolean
  location varchar
  other_complement text
  comments text

  Note: '''
  ROBOTS_CATEG_EXT = _product.category_.robots_extID
  Si existe → solo productos child_of Robots
  Si no → todos activos
  '''
}

Table x_lista_de_robots_tag {
  id int [pk, increment]
  name varchar [unique, note: 'name_uniq']
  color int
}

Table x_lista_de_robots_tag_rel {
  robot_id int [ref: > x_lista_de_robots.id]
  tag_id int [ref: > x_lista_de_robots_tag.id]
}

Table product_category {
  id int [pk, increment]
  name varchar
  parent_id int [ref: > product_category.id]
  Note: 'XML ID externo: _product.category_.robots_extID (no lo crea el módulo)'
}

Table product_product {
  id int [pk, increment]
  default_code varchar
  active boolean
}

// -------------------------------------------------------------
// MODULE: custom_giras
// -------------------------------------------------------------
Table maintenance_giras {
  id int [pk, increment]
  name varchar [not null]
  description text
}

// -------------------------------------------------------------
// MODULE: custom_stock_picking
// -------------------------------------------------------------
Table stock_picking {
  id int [pk, increment]
  x_mat_equipo_destino int [ref: > maintenance_equipment.id, note: 'Equipo destino']
  x_mat_empleado_destino int [ref: > hr_employee.id, note: 'Empleado destino']
  x_fecha_recepcion date [note: 'Fecha de recepción']
}

// -------------------------------------------------------------
// MODULE: custom_maintenance
// (+ campos extra en equipment desde custom_helpdesk_maintenance)
// -------------------------------------------------------------
Table maintenance_equipment {
  id int [pk, increment]

  // custom_maintenance
  x_mat_cuenta_analitica int [ref: > account_analytic_account.id]
  x_mat_oportunidad int [ref: > crm_lead.id]
  x_mat_modelo int [ref: > product_template.id]
  x_mat_gira int [ref: > maintenance_giras.id]
  x_mat_alto float
  x_mat_largo float
  x_mat_ancho float
  x_mat_espirales int
  x_mat_segundo_brazo_de_pickeo boolean
  x_mat_modulo_refrigeracion boolean
  x_mat_modulo_limpieza boolean
  x_mat_vidrios_laterales int
  x_mat_vidrios_piso boolean
  x_mat_vidrios_fondo boolean
  x_mat_easy_load boolean
  x_mat_buffer_easy_load float
  x_mat_transporte int
  x_mat_ubicacion varchar

  // custom_helpdesk_maintenance
  partner_id int [ref: > res_partner.id, note: 'Cliente']
  robot_out_of_service boolean [note: 'default False — banners']
  suspended_support boolean [note: 'default False — banners']
}

// -------------------------------------------------------------
// MODULE: custom_helpdesk_maintenance
// -------------------------------------------------------------
Table helpdesk_ticket {
  id int [pk, increment]
  ticket_type_id int [ref: > helpdesk_ticket_type.id, note: 'nativo; tipos custom en data XML']
  equipment_id int [ref: > maintenance_equipment.id]
  tour_id int [ref: > maintenance_giras.id, note: 'Related stored ← equipment.x_mat_gira']
  analytic_account_id int [ref: > account_analytic_account.id]
  progress varchar [note: '0|25|50|75|100']
  x_resuelto_ia boolean
  suspended_support boolean [note: 'Related stored ← equipment']
  robot_out_of_service boolean [note: 'Related stored ← equipment']
  parent_ticket_id int [ref: > helpdesk_ticket.id]
  maintenance_request_id int [ref: > maintenance_request.id, note: 'Legacy']
  maintenance_count int [note: 'Computed']
  // employee_follower_ids M2M → helpdesk_ticket_hr_employee_rel
  // evidence_ids M2M → helpdesk_ticket_ir_attachment_rel
  // maintenance_request_ids M2M → helpdesk_ticket_maintenance_request_rel

  Note: '''
  Envío/Retiro → actividad SOLO "Atender solicitud de Envío/Retiro"
  STOCK_MANAGER_JOB_EXT = _hr.job_.stockManager_extID (puesto ya existente, NO lo crea el módulo)
  Empleado con job + user_id → asigna actividad
  Si no → no crea esa actividad (no afecta otras actividades del sistema)
  '''
}

Table helpdesk_ticket_type {
  id int [pk, increment]
  name varchar [note: 'data XML: Envío/Retiro, Calibración, Commissioning, etc.']
}

Table helpdesk_ticket_hr_employee_rel {
  helpdesk_ticket_id int [ref: > helpdesk_ticket.id]
  hr_employee_id int [ref: > hr_employee.id]
  Note: 'employee_follower_ids'
}

Table helpdesk_ticket_ir_attachment_rel {
  helpdesk_ticket_id int [ref: > helpdesk_ticket.id]
  ir_attachment_id int [ref: > ir_attachment.id]
  Note: 'evidence_ids'
}

Table helpdesk_ticket_maintenance_request_rel {
  ticket_id int [ref: > helpdesk_ticket.id]
  request_id int [ref: > maintenance_request.id]
  Note: 'maintenance_request_ids / ticket_ids'
}

Table maintenance_request {
  id int [pk, increment]
  ticket_origin_id int [ref: > helpdesk_ticket.id, note: 'Origen legacy']
  partner_id int [ref: > res_partner.id]
  tour_id int [ref: > maintenance_giras.id, note: 'Related stored ← equipment.x_mat_gira']
  robot_out_of_service boolean [note: 'Related stored ← equipment']
  assigned_employee_id int [ref: > hr_employee.id]
  equipment_manager_id int [ref: > hr_employee.id, note: 'Related ← equipment.employee_id']
  ticket_count int [note: 'Computed']
  is_overdue boolean [note: 'Computed']
  kanban_state varchar [note: 'Computed stored: normal|done|blocked']
}

// Automatización Envío/Retiro (consulta; no crea hr.job)
Table hr_job {
  id int [pk, increment]
  name varchar
  Note: 'Externo producción: _hr.job_.stockManager_extID — el módulo NO lo crea'
}

Table mail_activity {
  id int [pk, increment]
  res_model varchar
  res_id int
  user_id int [ref: > res_users.id]
  summary varchar [note: 'Solo se intercepta: Atender solicitud de Envío/Retiro']
  note text
}

// -------------------------------------------------------------
// NATIVE / SHARED REFERENCES
// -------------------------------------------------------------
Table res_currency {
  id int [pk, increment]
  name varchar
}

Table account_analytic_account {
  id int [pk, increment]
  name varchar
}

Table product_template {
  id int [pk, increment]
  name varchar
}

Table res_partner {
  id int [pk, increment]
  name varchar
  parent_id int [ref: > res_partner.id]
}

Table res_users {
  id int [pk, increment]
  login varchar
  partner_id int [ref: > res_partner.id]
}

Table hr_employee {
  id int [pk, increment]
  name varchar
  job_id int [ref: > hr_job.id]
  user_id int [ref: > res_users.id, note: 'Requerido para actividad Envío/Retiro']
  active boolean
}

Table ir_attachment {
  id int [pk, increment]
  name varchar
}

Table sale_order {
  id int [pk, increment]
  name varchar
  partner_id int [ref: > res_partner.id]
  opportunity_id int [ref: > crm_lead.id]
}
