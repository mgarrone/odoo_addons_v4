// ==========================================
// DBML SCHEMA FOR CUSTOM ODOO MODULES
// Actualizado Julio 2026 — fusionado con cambios
// custom_crm_v4 | custom_project | custom_helpdesk_maintenance
// Copy and paste this code in dbdiagram.io
// ==========================================

// -------------------------------------------------------------
// MODULE: custom_crm_v4 (antes custom_crm)
// -------------------------------------------------------------
Table crm_lead {
  id int [pk, increment]
  currency_id int [ref: > res_currency.id, note: 'Moneda (Many2one)']
  partner_id int [ref: > res_partner.id, note: 'Cliente']

  // --- custom_crm_v4: Información adicional / Seguimiento ---
  x_proyecto_id int [ref: > project_project.id, note: 'COMPUTED readonly — proyecto vinculado vía opportunity_id']
  x_complejidad varchar [note: 'Selection: bajo | normal | alto']
  x_canal_de_ingreso varchar
  x_id_cliente int [note: 'Related partner_id.id']
  x_responsable_comercial_id int [ref: > res_users.id]
  x_responsable_proyecto_id int [ref: > res_users.id]
  x_cantidad_robots int
  // project_ids = O2M inversa (definida en custom_project)
  // x_detalle_de_equipos = O2M → x_lista_de_robots (vía opportunity_id)
  // x_cotizaciones = O2M → sale_order (vía opportunity_id)
  // x_contacto_ids = M2M → res_partner (tabla rel abajo)

  // Campos de Cronología
  x_studio_ingreso_consulta date
  x_studio_date_field_3vh_1jau2o5rh date [note: 'Primer Llamada']
  x_studio_videollamada date
  x_studio_reunin_presencial date
  x_studio_envo_presentacin date
  x_studio_envo_ffq date
  x_studio_cotizacin date
  x_studio_firma_cotizacin date
  x_studio_acta_ec date
  x_studio_vencimiento date
  x_studio_visita_de_cortesa date
  x_fecha_torta_aniversario date
  x_fecha_foto_aniversario date

  // Campos de Datos de Cotización
  x_studio_cotizacin_bd varchar
  x_studio_char_field_4bc_1jbo2kegr varchar [note: 'Url Cotización']
  x_studio_modelo_comercial_1 varchar [note: 'Selection']
  x_studio_tipo_de_cotizacin varchar [note: 'Selection']
  x_studio_hardware float [note: 'Monetary']
  x_studio_servicio float [note: 'Monetary']
  x_studio_descuento_aplicado_ float
  x_studio_total_neto float [note: 'Monetary']
  x_studio_nmero_de_venta int
  x_studio_nmero_de_cliente int
  x_studio_nmero_de_instalacin int

  // Campos de Producto Cotizado (legacy Studio)
  x_studio_producto varchar [note: 'Selection']
  x_studio_alto float
  x_studio_ancho float
  x_studio_largo float
  x_studio_salidas int
  x_studio_capacidad_mnima_1 int
  x_studio_capacidad_mxima int
  x_studio_cinta_de_transporte_1 float
  x_studio_easy_load_1 int
  x_studio_espirales_1 int
  x_studio_vidrios_laterales_1 int
  x_studio_vidrios_fondo int
  x_studio_vidrios_piso int
  x_studio_ubicacin varchar [note: 'Selection']
  x_studio_software_gestion_text varchar
  x_studio_otro_complemento varchar [note: 'HTML text']

  Note: '''
  custom_crm_v4:
  - Layout Información adicional: Compañía|Contactos / Marketing|Seguimiento
  - x_proyecto_id se calcula desde project.project.opportunity_id
  '''
}

Table crm_lead_x_contacto_rel {
  lead_id int [ref: > crm_lead.id]
  partner_id int [ref: > res_partner.id]
  Note: 'x_contacto_ids — Contactos de la empresa (M2M)'
}

// -------------------------------------------------------------
// MODULE: custom_project
// -------------------------------------------------------------
Table project_project {
  id int [pk, increment]
  name varchar
  opportunity_id int [unique, ref: > crm_lead.id, note: 'UNIQUE: 1 oportunidad = 1 proyecto']
  bd_robot_code varchar [note: 'BD Código de robot']
  bd_pid int [note: 'BD PID']
  // robot_scenario_ids = O2M → x_lista_de_robots
  // type_ids = M2M → project_task_type (etapas compartidas)

  Note: '''
  custom_project:
  - Al setear opportunity_id → sync a escenarios + refresca x_proyecto_id en CRM
  - Etapas default vinculadas a todos los proyectos
  '''
}

Table project_task_type {
  id int [pk, increment]
  name varchar
  sequence int
  Note: '''
  Etapas XML custom_project:
  A realizar | En proceso | Finalizadas | Canceladas
  '''
}

Table project_project_task_type_rel {
  project_id int [ref: > project_project.id]
  type_id int [ref: > project_task_type.id]
  Note: 'Etapas del proyecto (type_ids)'
}

Table x_lista_de_robots {
  id int [pk, increment]
  name varchar [not null]
  project_id int [ref: > project_project.id]
  opportunity_id int [ref: > crm_lead.id, note: 'readonly — sync auto desde project']
  product_id int [ref: > product_product.id, note: 'dominio categoría Robots (XML ID)']
  scenario int
  ffq_url varchar
  height float
  length float
  width float
  min_capacity int
  max_capacity int
  conveyor_belt float
  deflectors int
  easy_load boolean
  easy_load_buffer float
  spirals int
  second_picking_arm boolean
  second_input_belt boolean
  refrigeration_module boolean
  cleaning_module boolean
  side_glasses int
  back_glass boolean
  floor_glass boolean
  location varchar [note: 'Selection']
  other_complement text
  comments text

  Note: '''
  Filtro productos:
  ROBOTS_CATEG_EXT = _product.category_.robots_extID
  Si existe → child_of categoría Robots
  Si no → todos los activos
  '''
}

Table x_lista_de_robots_tag {
  id int [pk, increment]
  name varchar [unique]
  color int
}

Table x_lista_de_robots_tag_rel {
  robot_id int [ref: > x_lista_de_robots.id]
  tag_id int [ref: > x_lista_de_robots_tag.id]
}

Table product_category {
  id int [pk, increment]
  name varchar
  parent_id int [ref: > product_category.id]
  Note: 'XML ID: _product.category_.robots_extID'
}

Table product_product {
  id int [pk, increment]
  default_code varchar
  active boolean
  // categ_id vía product.template
}

// -------------------------------------------------------------
// MODULE: custom_giras
// -------------------------------------------------------------
Table maintenance_giras {
  id int [pk, increment]
  name varchar [not null, note: 'Nombre']
  description text [note: 'Descripción']
}

// -------------------------------------------------------------
// MODULE: custom_stock_picking
// -------------------------------------------------------------
Table stock_picking {
  id int [pk, increment]
  x_mat_equipo_destino int [ref: > maintenance_equipment.id, note: 'Equipo destino (Many2one)']
}

// -------------------------------------------------------------
// MODULE: custom_maintenance & custom_helpdesk_maintenance
// -------------------------------------------------------------
Table maintenance_equipment {
  id int [pk, increment]

  // From custom_maintenance
  x_mat_cuenta_analitica int [ref: > account_analytic_account.id, note: 'Cuenta analítica']
  x_mat_oportunidad int [ref: > crm_lead.id, note: 'Oportunidad']
  x_mat_modelo int [ref: > product_template.id, note: 'Modelo']
  x_mat_gira int [ref: > maintenance_giras.id, note: 'Gira']
  x_mat_alto float
  x_mat_largo float
  x_mat_ancho float
  x_mat_espirales int
  x_mat_segundo_brazo_de_pickeo boolean
  x_mat_modulo_refrigeracion boolean
  x_mat_modulo_limpieza boolean
  x_mat_vidrios_laterales int
  x_mat_vidrios_piso boolean
  x_mat_vidrios_fondo boolean
  x_mat_easy_load boolean
  x_mat_buffer_easy_load float
  x_mat_transporte int
  x_mat_ubicacion varchar

  // From custom_helpdesk_maintenance
  partner_id int [ref: > res_partner.id, note: 'Cliente (Many2one)']
  // suspended_support / robot_out_of_service (flags usados en banners)
}

Table helpdesk_ticket {
  id int [pk, increment]

  // From custom_helpdesk_maintenance
  ticket_type_id int [ref: > helpdesk_ticket_type.id]
  equipment_id int [ref: > maintenance_equipment.id, note: 'Equipo']
  tour_id int [ref: > maintenance_giras.id, note: 'Gira (related)']
  analytic_account_id int [ref: > account_analytic_account.id]
  progress varchar [note: 'Progreso (Selection)']
  x_resuelto_ia boolean
  parent_ticket_id int [ref: > helpdesk_ticket.id, note: 'Ticket Padre']
  maintenance_request_id int [ref: > maintenance_request.id, note: 'Solicitud legacy']
  maintenance_count int [note: 'Computed Field']
  // maintenance_request_ids M2M (tabla rel abajo)

  Note: '''
  Envío/Retiro → actividad automática:
  STOCK_MANAGER_JOB_EXT = _hr.job_.stockManager_extID
  Empleado con ese puesto + user_id → mail.activity
  Si no hay responsable válido → NO crear actividad
  '''
}

Table helpdesk_ticket_type {
  id int [pk, increment]
  name varchar [note: 'Envío/Retiro, Calibración, etc.']
}

// M2M relations for helpdesk_ticket
Table helpdesk_ticket_hr_employee_rel {
  helpdesk_ticket_id int [ref: > helpdesk_ticket.id]
  hr_employee_id int [ref: > hr_employee.id]
  Note: 'Seguidores del ticket (M2M)'
}

Table helpdesk_ticket_ir_attachment_rel {
  helpdesk_ticket_id int [ref: > helpdesk_ticket.id]
  ir_attachment_id int [ref: > ir_attachment.id]
  Note: 'Evidencia (M2M)'
}

Table helpdesk_ticket_maintenance_request_rel {
  ticket_id int [ref: > helpdesk_ticket.id]
  request_id int [ref: > maintenance_request.id]
  Note: 'maintenance_request_ids / ticket_ids (M2M)'
}

Table maintenance_request {
  id int [pk, increment]

  // From custom_helpdesk_maintenance
  ticket_origin_id int [ref: > helpdesk_ticket.id, note: 'Origen del Ticket']
  partner_id int [ref: > res_partner.id, note: 'Cliente']
  tour_id int [ref: > maintenance_giras.id, note: 'Gira']
  assigned_employee_id int [ref: > hr_employee.id, note: 'Empleado asignado a Mantenimiento']
  equipment_manager_id int [ref: > hr_employee.id, note: 'Responsable de equipo (Related)']
  ticket_count int [note: 'Computed Field']
  is_overdue boolean [note: 'Computed Field']
}

// -------------------------------------------------------------
// Automatización Envío/Retiro (HR + mail.activity)
// -------------------------------------------------------------
Table hr_job {
  id int [pk, increment]
  name varchar
  Note: 'XML ID: _hr.job_.stockManager_extID → Responsable de inventario'
}

Table mail_activity {
  id int [pk, increment]
  res_model varchar [note: 'helpdesk.ticket']
  res_id int
  user_id int [ref: > res_users.id]
  summary varchar [note: 'Atender solicitud de Envío/Retiro']
  note text
}

// -------------------------------------------------------------
// EXTERNAL / NATIVE ODOO TABLES REFERENCED
// -------------------------------------------------------------
Table res_currency {
  id int [pk, increment]
  name varchar
}

Table account_analytic_account {
  id int [pk, increment]
  name varchar
}

Table product_template {
  id int [pk, increment]
  name varchar
}

Table res_partner {
  id int [pk, increment]
  name varchar
  parent_id int [ref: > res_partner.id]
}

Table res_users {
  id int [pk, increment]
  login varchar
  partner_id int [ref: > res_partner.id]
}

Table hr_employee {
  id int [pk, increment]
  name varchar
  job_id int [ref: > hr_job.id]
  user_id int [ref: > res_users.id, note: 'Obligatorio para recibir actividad Envío/Retiro']
  active boolean
}

Table ir_attachment {
  id int [pk, increment]
  name varchar
}

Table sale_order {
  id int [pk, increment]
  name varchar
  partner_id int [ref: > res_partner.id]
  opportunity_id int [ref: > crm_lead.id]
}
