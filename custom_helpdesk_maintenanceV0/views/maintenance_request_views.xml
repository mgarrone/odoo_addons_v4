<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_request_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.form.inherit.merged</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//header" position="inside">
                <button name="action_create_helpdesk_ticket" 
                        type="object" 
                        string="Crear Ticket de Soporte" 
                        class="oe_highlight" />
            </xpath>

            <xpath expr="//sheet" position="before">
                <field name="ticket_count" invisible="1"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_helpdesk_tickets" 
                            type="object" 
                            class="oe_stat_button" 
                            icon="fa-life-ring">
                        <field name="ticket_count" widget="statinfo" string="Tickets"/>
                    </button>
                </div>
            </xpath>
            
            <xpath expr="//sheet" position="inside">
                <field name="ticket_count" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='equipment_id']" position="attributes">
                <attribute name="domain">[]</attribute>
            </xpath>

            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="partner_id" />
                <field name="tour_id" options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//field[@name='maintenance_team_id']" position="after">
                <field name="equipment_manager_id" />
                <field name="assigned_employee_id" />
            </xpath>

            <xpath expr="//sheet" position="inside">
                <field name="ticket_origin_id" readonly="1" invisible="1"/>
                <field name="ticket_ids" invisible="1"/>
                <field name="robot_out_of_service" invisible="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_maintenance_request_kanban_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.kanban.inherit.merged</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="is_overdue"/>
                <field name="schedule_date"/>
            </xpath>

            <xpath expr="//t[@t-name='kanban-box']/div" position="attributes">
                <attribute name="t-attf-class">
                    {{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} 
                    oe_kanban_card oe_kanban_global_click oe_semantic_html_override
                    #{record.is_overdue.raw_value ? 'bg-danger text-white' : ''}
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>