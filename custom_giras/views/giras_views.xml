<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista de lista de Giras -->
    <record id="view_giras_tree" model="ir.ui.view">
        <field name="name">maintenance.giras.tree</field>
        <field name="model">maintenance.giras</field>
        <field name="arch" type="xml">
            <tree string="Giras">
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulario de Giras -->
    <record id="view_giras_form" model="ir.ui.view">
        <field name="name">maintenance.giras.form</field>
        <field name="model">maintenance.giras</field>
        <field name="arch" type="xml">
            <form string="Gira">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Ingrese la descripción de la gira..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda de Giras -->
    <record id="view_giras_search" model="ir.ui.view">
        <field name="name">maintenance.giras.search</field>
        <field name="model">maintenance.giras</field>
        <field name="arch" type="xml">
            <search string="Giras">
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <!-- Acción de menú para Giras -->
    <record id="action_giras" model="ir.actions.act_window">
        <field name="name">Giras</field>
        <field name="res_model">maintenance.giras</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva gira
            </p>
        </field>
    </record>

    <!-- Menú para Giras -->
    <menuitem id="menu_giras"
              name="Giras"
              parent="maintenance.menu_maintenance_title"
              action="action_giras"
              sequence="20"/>
</odoo>
